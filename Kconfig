mainmenu "Matter nRF Connect Jamjari Occupancy Sensor"

# 잠자리는 USB 전원이라 잠들 필요가 없다. 9/30 SED+LIT(ICD) 설정으로는 SmartThings 등록 중
# Thread 네트워크에 붙지 못하고 fail-safe 로 취소됐다. 전구 예제(등록 성공)와 같은 FTD·ICD 끔으로 둔다.
choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
	default OPENTHREAD_NORDIC_LIBRARY_FTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
	default OPENTHREAD_FTD
endchoice

config CHIP_ENABLE_ICD_SUPPORT
	default n

menu "Jamjari direct upload"

config JAMJARI_DIRECT_UPLOAD
	bool "Board uploads events to the web server itself (Thread -> NAT64 -> HTTPS)"
	default n
	select MBEDTLS_TLS_LIBRARY
	# OT defconfig 가 TLS·클라이언트 기본값을 n 으로 둔다(조이너 등이 없을 때) → 여기서 켠다
	select MBEDTLS_SSL_TLS_C
	select MBEDTLS_SSL_CLI_C
	select PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY
	select PSA_WANT_RSA_KEY_SIZE_4096
	select PSA_WANT_ALG_RSA_PKCS1V15_SIGN
	select PSA_WANT_ALG_RSA_PSS
	# 뿌리 인증서가 SHA-384 로 서명됨(GTS R1). R4·X2(Cloudflare 쪽)는 P-384 키
	select PSA_WANT_ALG_SHA_384
	select PSA_WANT_ECC_SECP_R1_384
	help
	  E 계획: 보드가 맥 없이 SmartThings Station 의 NAT64 를 거쳐 jamjari.vercel.app 에
	  HTTPS 로 직접 올린다. Vercel 인증서가 RSA(루트 4096비트)라 RSA 검증을 켠다.
	  맥 수집기와 동시에 켜지 않는다(같은 사건이 두 번 저장됨).

endmenu

menu "Jamjari radar"

comment "지켜볼 구역(mm). 레이더 정면이 +y, 레이더에서 봐서 좌우가 x. 경계 포함."
comment "구역 밖 점은 사람으로 치지 않는다 (약 4m 거리의 유령 점을 거르려는 것)."

config JAMJARI_ZONE_XMIN
	int "Zone x min (mm)"
	range -6000 6000
	default -1500

config JAMJARI_ZONE_XMAX
	int "Zone x max (mm)"
	range -6000 6000
	default 1500

config JAMJARI_ZONE_YMIN
	int "Zone y min (mm)"
	range 0 8000
	default 0

config JAMJARI_ZONE_YMAX
	int "Zone y max (mm)"
	range 0 8000
	default 3000

config JAMJARI_RADAR_SUMMARY_LOG
	bool "Log a radar summary once per second"
	default y
	help
	  1초에 한 번 받은 프레임 수, 버린 바이트, 원시 타깃 수, 구역 안 사람(이름·x·y),
	  점유 상태를 INF 로 찍는다. 5초 넘게 프레임이 없으면 WRN 을 찍는다(이 경고는 끄지 않는다).

config JAMJARI_FRAME_LOG
	bool "Log one line per radar frame (for recording)"
	depends on LOG
	default y
	help
	  레이더 프레임 한 장마다 한 줄을 찍는다. 맥의 레이더_지도.py --source nrf 가 읽어서
	  지도로 그리고 녹화한다. 형식:
	    F <ms> <슬롯1> <슬롯2> <슬롯3> <구역 안 트랙 수> <occ>
	  슬롯은 원시 타깃 x,y,speed(mm, mm/s) 또는 빈 슬롯이면 -. 구역·트래커 전 값이다.
	  끝의 두 숫자는 보드가 그 프레임을 처리한 뒤의 판단(트랙 수, Occupancy 0/1).
	  한 줄 약 70바이트 × 초당 12장 ≈ 115200bps 의 8% 정도.

config JAMJARI_RADAR_REPLAY
	bool "Demo: read LD2450 frames from the Mac over VCOM instead of the radar"
	default n
	help
	  시연용(10/3, 센서 입력은 전부 더미로 가기로 함). 레이더 선 대신 디버거 USB 의 두 번째
	  통로(uart30, VCOM0, 115200bps)에서 LD2450 과 같은 30바이트 프레임을 받는다.
	  맥의 dummy/보드재생.py 가 더미 장면을 이 통로로 흘려 넣는다. 판단 코드는 그대로다.
	  ./build.sh --replay 가 replay/ 의 overlay·conf 로 켠다. 레이더용 빌드에는 쓰지 않는다.

config JAMJARI_FUSION
	bool "Board-side fusion: seat states + pet spots from replayed radar + 60GHz"
	depends on JAMJARI_RADAR_REPLAY
	default y
	help
	  보드 추정(10/5 N, 설계-보드추정.md). 맥 dummy/보드재생.py --g60 이 장면 시각을 붙여 보낸
	  레이더·60GHz 좌우 프레임으로 칸 상태(사람·반려동물로 추정·구분 안 됨·비어 있음)와
	  반려동물 머문 자리(10분 이상·최대 3개)를 보드에서 계산해 웹으로 보낸다(seat·spot 사건).
	  60GHz 는 가상 센서다.

comment "침대 칸 규칙 (설계-레이더2차.md). 침대 좌표가 모두 0 이면 끔 → 예전 규칙(구역 안 사람 있으면 1)."
comment "좌표계는 구역과 같다. 침대 사각형은 구역 안에 있어야 한다."

config JAMJARI_BED_XMIN
	int "Bed x min (mm)"
	range -6000 6000
	default 0

config JAMJARI_BED_XMAX
	int "Bed x max (mm)"
	range -6000 6000
	default 0

config JAMJARI_BED_YMIN
	int "Bed y min (mm)"
	range 0 8000
	default 0

config JAMJARI_BED_YMAX
	int "Bed y max (mm)"
	range 0 8000
	default 0

config JAMJARI_BED_SPLIT_X
	int "Bed left/right split x (mm)"
	range -6000 6000
	default 0
	help
	  x 가 이 값보다 작으면 왼쪽 칸(L), 아니면 오른쪽 칸(R). 레이더에서 본 기준.

config JAMJARI_BED_EDGE_MM
	int "Bed edge band width (mm)"
	range 0 2000
	default 300
	help
	  침대 좌우 두 변과 발치(ymin, 레이더 쪽) 안쪽 띠. 머리맡(ymax)은 띠 없음.
	  그 칸에서 온 점이 이 띠에서 사라지면 자리 뜸으로 본다.

config JAMJARI_LEAVE_DELAY_MS
	int "Delay before Occupancy=0 (ms)"
	range 1000 600000
	default 10000
	help
	  두 칸 다 꺼진 뒤(예전 규칙: 구역 안 사람이 없어진 뒤) Occupancy=0 까지.

config JAMJARI_HOLD_MAX_MIN
	int "Max hold without any point in bed (min)"
	range 1 1440
	default 720
	help
	  안전장치. 침대 안 점이 이만큼 하나도 없으면 두 칸 다 끈다.

config JAMJARI_MOVE_GAP_MS
	int "Movement gap that splits events (ms)"
	range 100 60000
	default 1000

config JAMJARI_MOVE_MIN_MS
	int "Minimum movement length (ms)"
	range 0 60000
	default 2000

config JAMJARI_FOLLOW_MS
	int "Follow window for L>R / R>L (ms)"
	range 0 600000
	default 30000
	help
	  한 칸 움직임이 끝나고 이 시간 안에 다른 칸이 시작하면 뒤쪽 줄에 「이어서 움직임」(L>R).
	  30000 = Pankhurst & Horne 1994 부부 연구의 30초 칸. 60000 = Hoffman 2020 개–사람 1분.
	  사람끼리 시차를 직접 잰 연구는 못 찾음(설계-레이더2차.md §3).

config JAMJARI_EVENT_LOG
	bool "Log JJ1,EV event lines"
	depends on LOG
	default y
	help
	  사건 줄 JJ1,EV,<seq>,<kind>,<start_ms>,<end_ms>,<size>,<x>,<y>,<count>,<flags>,<side> 를 찍는다.

endmenu

menu "Jamjari virtual temperature"

comment "시연용 가상 온도(endpoint 3). 범위는 ZAP 의 Min/MaxMeasuredValue(-10~40도)."

config JAMJARI_TEMP_START_CENTI
	int "Start temperature (0.01 C)"
	range -1000 4000
	default 2500

config JAMJARI_TEMP_STEP_CENTI
	int "Button step (0.01 C)"
	range 1 1000
	default 100

endmenu

